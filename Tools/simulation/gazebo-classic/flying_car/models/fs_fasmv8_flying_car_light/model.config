<?xml version="1.0"?>
<model>
  <name>fs_fasmv8_flying_car_light</name>
  <version>1.0</version>
  <sdf version='1.6'>fs_fasmv8_flying_car_light.sdf</sdf>

  <author>
   <name>FS-FASMv8 Light Variant Developer</name>
   <email>dev@example.com</email>
  </author>

  <description>
    Lightweight (50 kg) variant of the FS-FASMv8 flying car.
    Designed with TWR=2.0 (hover throttle ~50%) for stable SITL flight testing.
    Based on the FS-FASMv8_octo geometry with mass and inertia scaled by 0.05
    (from 1000 kg to 50 kg) and motor thrust tuned accordingly.
  </description>
</model>