      <accelerometerRandomWalk>0.0002</accelerometerRandomWalk>
      <accelerometerBiasCorrelationTime>10000.0</accelerometerBiasCorrelationTime>
      <accelerometerTurnOnBiasSigma>0.05</accelerometerTurnOnBiasSigma>
