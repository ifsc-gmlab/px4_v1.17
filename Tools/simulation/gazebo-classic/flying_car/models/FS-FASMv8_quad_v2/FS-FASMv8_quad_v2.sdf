    </plugin>

        <plugin name='rotors_gazebo_mag_plugin' filename='libgazebo_magnetometer_plugin.so'>
      <robotNamespace/>

      <pubRate>50</pubRate>
      <magTopic>/mag</magTopic>
    </plugin>

        <plugin name='rotors_gazebo_baro_plugin' filename='libgazebo_barometer_plugin.so'>
      <robotNamespace/>

      <pubRate>50</pubRate>
      <baroTopic>/baro</baroTopic>
