          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name='joint8' type='revolute'>
      <pose relative_to='base_link'>-0.35 -0.25 -0.15 0 0 0</pose>
      <parent>base_link</parent>
      <child>link8</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>1200</effort>
          <velocity>40</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
