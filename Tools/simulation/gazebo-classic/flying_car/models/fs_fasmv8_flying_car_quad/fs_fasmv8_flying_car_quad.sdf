<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='FS-FASMv8_quad'>
    <link name='base_link'>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.2</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.45</iyy>
          <iyz>0</iyz>
          <izz>0.6</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.8 0.5 0.2</size>
          </box>
        </geometry>
      </collision>
      <visual name='base_link_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.8 0.5 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.3 0.5 1</ambient>
          <diffuse>0.3 0.4 0.6 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>

    <joint name='/joint_imu' type='revolute'>
      <pose relative_to='base_link'>0 0 0 0 0 0</pose>
      <child>/link_imu</child>
      <parent>base_link</parent>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>
    <link name='/link_imu'>
      <pose relative_to='/joint_imu'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
    </link>

    <!-- F450 X quad rotors (PX4 FRD -> Gazebo FLU: y_FLU = -y_FRD) -->
    <joint name='joint1' type='revolute'>
      <pose relative_to='base_link'>0.225 -0.225 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>link1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
      </axis>
    </joint>
    <link name='link1'>
      <pose relative_to='joint1'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='link1_visual'>
        <geometry>
          <cylinder>
            <length>0.05</length>
            <radius>0.05</radius>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name='joint2' type='revolute'>
      <pose relative_to='base_link'>-0.225 0.225 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>link2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
      </axis>
    </joint>
    <link name='link2'>
      <pose relative_to='joint2'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='link2_visual'>
        <geometry>
          <cylinder>
            <length>0.05</length>
            <radius>0.05</radius>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name='joint3' type='revolute'>
      <pose relative_to='base_link'>0.225 0.225 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>link3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
      </axis>
    </joint>
    <link name='link3'>
      <pose relative_to='joint3'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='link3_visual'>
        <geometry>
          <cylinder>
            <length>0.05</length>
            <radius>0.05</radius>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name='joint4' type='revolute'>
      <pose relative_to='base_link'>-0.225 -0.225 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>link4</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
      </axis>
    </joint>
    <link name='link4'>
      <pose relative_to='joint4'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='link4_visual'>
        <geometry>
          <cylinder>
            <length>0.05</length>
            <radius>0.05</radius>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <!-- 4 wheels: joint5..8, track 0.5 m (y=+-0.25), wheelbase 0.7 m -->
    <joint name='joint5' type='revolute'>
      <pose relative_to='base_link'>0.35 0.25 -0.15 0 0 0</pose>
      <parent>base_link</parent>
      <child>link5</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>1200</effort>
          <velocity>40</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.03</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='link5'>
      <pose relative_to='joint5'>0 0 0 1.5708 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.018</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.018</iyy>
          <iyz>0</iyz>
          <izz>0.018</izz>
        </inertia>
      </inertial>
      <collision name='link5_collision'>
        <geometry>
          <sphere>
            <radius>0.15</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu1>1.0</mu1>
              <mu2>1.0</mu2>
              <slip1>0.01</slip1>
              <slip2>0.01</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>5000</kd>
              <max_vel>1.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='link5_visual'>
        <geometry>
          <cylinder>
            <length>0.06</length>
            <radius>0.15</radius>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name='joint6' type='revolute'>
      <pose relative_to='base_link'>0.35 -0.25 -0.15 0 0 0</pose>
      <parent>base_link</parent>
      <child>link6</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>1200</effort>
          <velocity>40</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.03</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='link6'>
      <pose relative_to='joint6'>0 0 0 1.5708 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.018</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.018</iyy>
          <iyz>0</iyz>
          <izz>0.018</izz>
        </inertia>
      </inertial>
      <collision name='link6_collision'>
        <geometry>
          <sphere>
            <radius>0.15</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu1>1.0</mu1>
              <mu2>1.0</mu2>
              <slip1>0.01</slip1>
              <slip2>0.01</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>5000</kd>
              <max_vel>1.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='link6_visual'>
        <geometry>
          <cylinder>
            <length>0.06</length>
            <radius>0.15</radius>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name='joint7' type='revolute'>
      <pose relative_to='base_link'>-0.35 0.25 -0.15 0 0 0</pose>
      <parent>base_link</parent>
      <child>link7</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>1200</effort>
          <velocity>40</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.03</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='link7'>
      <pose relative_to='joint7'>0 0 0 1.5708 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.018</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.018</iyy>
          <iyz>0</iyz>
          <izz>0.018</izz>
        </inertia>
      </inertial>
      <collision name='link7_collision'>
        <geometry>
          <sphere>
            <radius>0.15</radius>
          </sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu1>1.0</mu1>
              <mu2>1.0</mu2>
              <slip1>0.01</slip1>
              <slip2>0.01</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>5000</kd>
              <max_vel>1.0</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name='link7_visual'>
        <geometry>
          <cylinder>
            <length>0.06</length>
