    <link name='link8'>
      <pose relative_to='joint8'>0 0 0 1.5708 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.018</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.018</iyy>
          <iyz>0</iyz>
