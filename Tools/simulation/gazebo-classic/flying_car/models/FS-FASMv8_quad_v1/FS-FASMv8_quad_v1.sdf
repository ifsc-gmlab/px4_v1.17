      </axis>
    </joint>

    <!-- ===== WHEELS (kept from user, already PX4-style with collision+visual+surface) ===== -->
    <link name="wheel_fl">
      <pose>-0.115 0.128218 -0.025 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.005</iyy><iyz>0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>
      <collision name="wheel_fl_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
      
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>0.0</threshold>
          </bounce>
        </surface>
      </collision>
      <visual name="wheel_fl_visual">
        <pose>-0.000189 0.018622 -0.000041 0 0 1.5708</pose>
        <geometry><mesh><scale>2.1467 2.1467 2.1467</scale><uri>model://FS-FASMv8_quad_v1/meshes/wheel_fl.stl</uri></mesh></geometry>
                <material>
          <script>
            <name>Gazebo/White</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
    </link>
    <joint name="wheel_fl_joint" type="revolute">
  <parent>base_link</parent>
  <child>wheel_fl</child>
  <axis>
    <xyz>0 1 0</xyz>
    <use_parent_model_frame>1</use_parent_model_frame>
  </axis>
  <limit>
    <lower>-1e+16</lower>
    <upper>1e+16</upper>
    <effort>20</effort>    <!-- 20 ??80 闂傚倸鍊搁崐鎼佸磹妞嬪海鐭嗗ù锝夋交閼板潡寮堕崼姘珔闁搞劍绻冮妵鍕冀椤愵澀绮剁紓浣插亾濠㈣埖鍔栭悡娑㈡煕閵夈垺娅呭ù鐘欏洦鐓?闂傚倸鍊搁崐鎼佸磹閻戣姤鍤勯柛顐ｆ磵閳ь剨绠撳畷濂稿Ψ閿旇姤鐝栭梻渚€娼ч悧鍡椕洪妸鈺傚剹闁瑰墽绮悡鏇熴亜椤撶喎鐏ュù婊呭仱閺??-->
    <velocity>20</velocity>
  </limit>
  <dynamics>
    <spring_reference>0</spring_reference>
    <spring_stiffness>0</spring_stiffness>
    <damping>0.1</damping> <!-- 0.05 ??0.005 濠电姷鏁告慨鐑藉极閸涘﹥鍙忓ù鍏兼綑閸ㄥ倻鎲搁悧鍫濈瑲闁稿顦甸弻鏇＄疀鐎ｎ亖鍋撻弴鐘电焼闁告劏鏂傛禍婊堢叓閸ャ劍灏版い銉у仦閹便劑鏁愰崨顖滃姱濠殿喖锕ら…宄扮暦閹烘埈娼╂い鎴ｆ娴滈箖鏌涘┑鍕姉闁稿鎸搁～婵嬫偂鎼粹槅娼剧紓鍌欑贰閸犳寮婚妸鈺傚仼闁绘垼妫勯悙濠囨煃閸濆嫬鏋ゆ俊鍙夋倐濮婄粯鎷呴搹骞库偓濠囨煕閹惧绠樼紒顔界懇楠炴帒螖閳ь剟鎮￠弴銏＄厵闁告挆鍛闂佺顑戠紞渚€寮诲☉銏犖ㄩ柨婵嗘噹椤牏绱撴担鐟扮祷妞ゎ厾鍏樺?-->
    <friction>0.03</friction>
  </dynamics>
</joint>

    <link name="wheel_fr">
      <pose>0.115 0.128218 -0.025 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.005</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.005</iyy><iyz>0</iyz>
          <izz>0.005</izz>
        </inertia>
      </inertial>
      <collision name="wheel_fr_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><sphere><radius>0.08</radius></sphere></geometry>
      
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu>
              <mu2>1.5</mu2>
