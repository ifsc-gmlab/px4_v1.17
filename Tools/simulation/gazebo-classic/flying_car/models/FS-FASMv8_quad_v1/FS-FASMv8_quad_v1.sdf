              <slip2>0.0</slip2>
            </ode>
          </friction>
          <bounce>
            <restitution_coefficient>0.0</restitution_coefficient>
            <threshold>0.0</threshold>
          </bounce>
        </surface>
      </collision>
      <visual name="wheel_fr_visual">
        <pose>-0.000570 -0.018480 0.000114 0 0 1.5708</pose>
        <geometry><mesh><scale>2.1474 2.1474 2.1474</scale><uri>model://FS-FASMv8_quad_v1/meshes/wheel_fr.stl</uri></mesh></geometry>
                <material>
          <script>
            <name>Gazebo/White</name>
