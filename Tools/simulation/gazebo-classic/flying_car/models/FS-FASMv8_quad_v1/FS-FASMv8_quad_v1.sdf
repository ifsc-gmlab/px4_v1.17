<?xml version="1.0"?>
<sdf version='1.6'>
  <model name='FS-FASMv8_quad_v1'>
    <pose>0 0 0.1 0 0 0</pose>
    <static>0</static>

    <!-- ===== BODY (PX4 / iris style) ===== -->
    <link name='base_link'>
      <pose>0 0 0.04 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0229</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0200</iyy>
          <iyz>0</iyz>
          <izz>0.0421</izz>
        </inertia>
      </inertial>
      <collision name='base_link_inertia_collision'>
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.28 0.30 0.04</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <max_vel>0</max_vel>
              <kp>1e6</kp>
              <kd>2000</kd>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>
      <visual name='base_link_inertia_visual'>
        <pose>0 0 0 0 0 -1.5708</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://FS-FASMv8_quad_v1/meshes/body.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <gravity>1</gravity>
    </link>

    <!-- ===== IMU (PX4 / iris style) ===== -->
    <!-- NOTE: link/joint names kept as 'flying_car/imu_*' to avoid breaking external references.
         All sensor plugins below consistently use this same name. -->
    <link name='imu_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.015</mass>
        <inertia>
          <ixx>1e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-05</iyy>
          <iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
    </link>
    <joint name='imu_joint' type='revolute'>
      <child>imu_link</child>
      <parent>base_link</parent>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>0</effort>
          <velocity>0</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <!-- ===== ROTOR 0 (FRONT-RIGHT, CCW) ===== -->
    <!-- PX4 FRD frame: X+ = right, Y- = front, Y+ = back -->
    <link name='rotor_0'>
      <pose>0.128438 0.190122 0.074310 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00273104</iyy>
          <iyz>0</iyz>
          <izz>0.00274004</izz>
        </inertia>
      </inertial>
      <visual name='rotor_0_visual'>
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://FS-FASMv8_quad_v1/meshes/rotor_1.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/White</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <gravity>1</gravity>
    </link>
    <joint name='rotor_0_joint' type='revolute'>
      <child>rotor_0</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <!-- ===== ROTOR 1 (FRONT-LEFT, CW) ===== -->
    <link name='rotor_1'>
      <pose>0.128438 -0.190122 0.074310 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00273104</iyy>
          <iyz>0</iyz>
          <izz>0.00274004</izz>
        </inertia>
      </inertial>
      <visual name='rotor_1_visual'>
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://FS-FASMv8_quad_v1/meshes/rotor_2.stl</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/White</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <gravity>1</gravity>
    </link>
    <joint name='rotor_1_joint' type='revolute'>
      <child>rotor_1</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>

    <!-- ===== ROTOR 2 (REAR-RIGHT, CCW) ===== -->
    <link name='rotor_2'>
      <pose>-0.128438 0.190166 0.074310 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>9.75e-06</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00273104</iyy>
          <iyz>0</iyz>
          <izz>0.00274004</izz>
        </inertia>
      </inertial>
      <visual name='rotor_2_visual'>
        <pose>0 0 0.03 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://FS-FASMv8_quad_v1/meshes/rotor_3.stl</uri>
