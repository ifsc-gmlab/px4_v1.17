          </script>
        </material>
      </visual>
    </link>
    <joint name="wheel_fr_joint" type="revolute">
      <parent>base_link</parent>
      <child>wheel_fr</child>
      <axis>
  <xyz>0 1 0</xyz>
  <use_parent_model_frame>1</use_parent_model_frame>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
          <effort>20</effort>    <!-- 20 ??80 闂傚倸鍊搁崐鎼佸磹妞嬪海鐭嗗ù锝夋交閼板潡寮堕崼姘珔闁搞劍绻冮妵鍕冀椤愵澀绮剁紓浣插亾濠㈣埖鍔栭悡娑㈡煕閵夈垺娅呭ù鐘欏洦鐓?闂傚倸鍊搁崐鎼佸磹閻戣姤鍤勯柛顐ｆ磵閳ь剨绠撳畷濂稿Ψ閿旇姤鐝栭梻渚€娼ч悧鍡椕洪妸鈺傚剹闁瑰墽绮悡鏇熴亜椤撶喎鐏ュù婊呭仱閺??-->
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
          <damping>0.1</damping>
          <friction>0.03</friction>
        </dynamics>
      </axis>
    </joint>

