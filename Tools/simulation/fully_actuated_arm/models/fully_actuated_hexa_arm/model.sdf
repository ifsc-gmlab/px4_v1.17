    <link name='arm_link_1'>
      <pose>0 0 -0.19 0 0 0</pose>
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name='arm_link_1_collision'>
