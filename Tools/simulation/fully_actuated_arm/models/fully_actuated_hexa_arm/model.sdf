          <ambient>0.01 0.03 0.35 1</ambient>
          <diffuse>0.03 0.15 0.95 1</diffuse>
          <specular>0.30 0.30 0.30 1</specular>
        </material>
      </visual>
      <collision name="rotor_1_collision">
        <geometry>
          <box>
