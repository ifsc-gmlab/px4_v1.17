<?xml version="1.0"?>
<launch>
    <arg name="gui" default="false"/>
    <arg name="world" default="$(find mavlink_sitl_gazebo)/worlds/FS_flying_car.world"/>
    <arg name="vehicle" default="fs_fasmv8_flying_car"/>
    <arg name="sdf" default="$(find mavlink_sitl_gazebo)/models/FS-FASMv8_octo/FS-FASMv8_octo.sdf"/>
    <arg name="my_model" default="FS-FASMv8_octo"/>
    <arg name="x" default="0"/>
    <arg name="y" default="30"/>
    <arg name="z" default="1.8"/>
    <arg name="R" default="0"/>
    <arg name="P" default="0"/>
    <arg name="Y" default="-1.5708"/>

    <arg name="config" default="$(find flying_car_test)/config/experiment.yaml"/>
    <arg name="result_dir" default="/tmp/flying_car_test_result"/>
    <arg name="model_name" default="fs_fasmv8_flying_car"/>
    <arg name="timeout_s" default="0"/>

    <arg name="rosbag_name" default="trial"/>
    <arg name="bag_output" default="$(arg result_dir)"/>

    <include file="$(find px4)/launch/FS_flying_car.launch">
        <arg name="x" value="$(arg x)"/>
        <arg name="y" value="$(arg y)"/>
        <arg name="z" value="$(arg z)"/>
        <arg name="R" value="$(arg R)"/>
        <arg name="P" value="$(arg P)"/>
        <arg name="Y" value="$(arg Y)"/>
        <arg name="world" value="$(arg world)"/>
        <arg name="vehicle" value="$(arg vehicle)"/>
        <arg name="sdf" value="$(arg sdf)"/>
        <arg name="my_model" value="$(arg my_model)"/>
        <arg name="gui" value="$(arg gui)"/>
        <arg name="interactive" value="false"/>
        <arg name="debug" value="false"/>
        <arg name="verbose" value="false"/>
        <arg name="paused" value="false"/>
        <arg name="respawn_gazebo" value="false"/>
        <arg name="mavros_launch"
             value="$(find flying_car_test)/launch/mavros_sitl_no_timesync.launch"/>
        <arg name="respawn_mavros" value="false"/>
    </include>

    <!-- monitor: passive aggregation; required so roslaunch dies if it dies -->
    <node pkg="flying_car_test" type="experiment_monitor.py"
          name="flying_car_experiment_monitor"
          output="screen"
          required="true">
        <param name="config_file" value="$(arg config)"/>
        <param name="result_dir" value="$(arg result_dir)"/>
        <param name="model_name" value="$(arg model_name)"/>
        <rosparam param="launch_arguments">{gui: $(arg gui), x: $(arg x), y: $(arg y)}</rosparam>
    </node>

    <!-- safety guard: independent arbitration layer (Task 7) -->
    <node pkg="flying_car_test" type="safety_guard.py"
          name="flying_car_safety_guard"
          output="screen"
          required="true">
        <param name="config_file" value="$(arg config)"/>
        <param name="result_dir" value="$(arg result_dir)"/>
        <param name="model_name" value="$(arg model_name)"/>
        <param name="heartbeat_required" value="true"/>
        <param name="startup_grace_s" value="5.0"/>
    </node>

    <!-- automatic controller: scoped remaps only here -->
    <node pkg="flying_car_test" type="experiment_controller.py"
          name="flying_car_experiment_controller"
          output="screen"
          required="true">
        <param name="config_file" value="$(arg config)"/>
        <param name="result_dir" value="$(arg result_dir)"/>
        <param name="model_name" value="$(arg model_name)"/>
        <param name="spawn_yaw" value="$(arg Y)"/>
        <remap from="/mavros/manual_control/send"
               to="/flying_car_safety_guard/controller/manual"/>
        <remap from="/mavros/setpoint_position/local"
               to="/flying_car_safety_guard/controller/pose"/>
    </node>

    <!-- passive recording of required evidence channels -->
    <node pkg="rosbag" type="record"
          name="flying_car_rosbag_record"
          output="screen"
          args="-O $(arg bag_output)/$(arg rosbag_name).bag
                /mavros/state
                /mavros/local_position/pose
                /mavros/local_position/velocity_local
                /flying_car_experiment_controller/command
                /flying_car_experiment_controller/phase
                /clock
                /gazebo/model_states"/>
</launch>
